      "label": "Product Design Principles",
      "file_type": "rationale",
      "source_file": "PRODUCT.md",
      "source_location": "## Design Principles",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "5 principles: Infrastructure over identity; Signal over noise; One voice at a time; Color means something; Legibility at speed."
    },
    {
