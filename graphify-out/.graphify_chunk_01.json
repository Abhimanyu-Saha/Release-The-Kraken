    {
      "id": "design_signal_tower",
      "label": "Signal Tower (Creative North Star)",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 1. Overview",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The tool should disappear; the interface exists to move content through a workflow, not to be noticed. Surfaces are quiet so the only color on screen is color that means something."
    },
    {
      "id": "design_tower_violet",
      "label": "Tower Violet (#aa3bff)",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 2. Colors",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single action accent color at 295 degrees. Appears on primary buttons, focus rings, active nav. Its rarity is what gives it signal power. One Voice Rule: at most 10% of any screen."
    },
    {
      "id": "design_status_colors",
      "label": "Status Colors (Semantic Signal System)",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 2. Colors: Status",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Amber=pending, blue=approved, green=published, gray=draft/archived. Semantic only, never decorative. Status Purity Rule: these colors appear exclusively inside status badges tied to release lifecycle."
    },
    {
      "id": "design_flat_by_default",
      "label": "Flat-By-Default Elevation Rule",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 4. Elevation",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Depth through tonal value (gray-50 vs white), not shadow. Shadows appear only in renderer hover states. No box-shadow on static builder cards."
    },
    {
      "id": "design_renderer_exception",
      "label": "Renderer Exception (Typography Rule)",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 3. Typography",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Builder body text is 14px for dense editing; renderer body is 18px for reading comfort. Different jobs, different comfort. The renderer is a communication surface, not a production environment."
    },
    {
      "id": "design_one_voice_rule",
      "label": "One Voice Rule",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 2. Colors: Named Rules",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Violet appears on at most 10% of any given screen. Two violet elements competing on the same screen is prohibited."
    },
    {
      "id": "design_retirement_rule",
      "label": "Retirement Rule (Indigo Banned)",
      "file_type": "rationale",
      "source_file": "DESIGN.md",
      "source_location": "## 2. Colors: Named Rules",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "indigo-600 (#4f46e5) and all Tailwind indigo-* values are retired. Violet (#aa3bff) is the canonical accent."
    },
